### Simulating projectile motion with 2D newtonian gravity

import numpy as np
import matplotlib.pyplot as plt
import scipy.integrate as sci

### Create Planet class
class Planet():
    def __init__(self):
        self.radius = 6.371e6 #m
        self.mass = 5.972e24 #kg
        self.G = 6.67430e-11 #m^3/kg/s^2
    
    def getRadius(self):
        return self.radius
    
    def getMass(self):
        return self.mass
    
    def gravity(self, x, z):
        r = np.sqrt(x**2 + z**2)  # distance from the center of the planet
        if r < self.radius:
            accel_x = 0.0
            accel_z = 0.0
        else:
            accel_x = self.G * self.mass / (r**3)*x
            accel_z = self.G * self.mass / (r**3)*z
        return np.asarray([accel_x, accel_z]),r

### Create Rocket class
class Rocket():
    def __init__(self, mass, max_thrust, Isp, cross_section, drag_coefficient):
        self.mass = mass
        self.max_thrust = max_thrust
        self.Isp = Isp
        self.v_exit = Isp * 9.81 # m/s
        self.cross_section = cross_section # m^2 
        self.drag_coefficient = drag_coefficient # dimensionless (typical for a rocket)

    def getMass(self):
        return self.mass
    
    def getMaxThrust(self):
        return self.max_thrust
    
    def getIsp(self):
        return self.Isp
    
    def getExitVelocity(self):
        return self.v_exit
    
    def getCrossSection(self):
        return self.cross_section
    
    def getDragCoefficient(self):
        return self.drag_coefficient

